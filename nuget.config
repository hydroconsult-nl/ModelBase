<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Hydroconsult packages (HYDROC01, HYDROC02) and packages that are not on nuget.org (Deltares.UGrid, ProtoBufRemote).
         GitHub Packages always needs a login, also for reading: see README.md, "Build". -->
    <add key="hydroconsult" value="https://nuget.pkg.github.com/hydroconsult-nl/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="hydroconsult">
      <package pattern="HYDROC01" />
      <package pattern="HYDROC02" />
      <package pattern="Deltares.UGrid" />
      <package pattern="ProtoBufRemote" />
    </packageSource>
  </packageSourceMapping>
</configuration>