<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- HYDROC01: project reference when HYDROC01 is checked out next to this repository (development),
         otherwise the NuGet package. Force one with /p:UseHYDROC01Project=true|false. -->
    <HYDROC01Version>2.9.5</HYDROC01Version>
    <UseHYDROC01Project Condition="'$(UseHYDROC01Project)' == '' and Exists('$(MSBuildThisFileDirectory)..\HYDROC01\HYDROC01\HYDROC01.vbproj')">true</UseHYDROC01Project>
  </PropertyGroup>

  <ItemGroup>
    <!-- MapWinGIS interop assembly in the repository, so the build does not need a registered MapWinGIS -->
    <Reference Include="Interop.MapWinGIS">
      <HintPath>References\MapWinGIS\Interop.MapWinGIS.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GMap.NET.Core" Version="2.1.7" />
    <PackageReference Include="GMap.NET.WinForms" Version="2.1.7" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseHYDROC01Project)' != 'true'">
    <PackageReference Include="HYDROC01" Version="$(HYDROC01Version)" />
    <!-- HYDROC01 needs the net40 ProtoBufRemote.dll; for net7.0 the package only offers ProtoBufRemote.Core.dll -->
    <PackageReference Include="ProtoBufRemote" Version="1.0.11" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="ProtoBufRemote">
      <HintPath>$(PkgProtoBufRemote)\lib\net40\ProtoBufRemote.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseHYDROC01Project)' == 'true'">
    <ProjectReference Include="..\HYDROC01\HYDROC01\HYDROC01.vbproj" />
    <ProjectReference Include="..\HYDROC02\HYDROC02.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <CustomToolNamespace>My</CustomToolNamespace>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>